{
  "version": 1,
  "chaine": "video-revelation-podcast",
  "resume": "Analyse, intention et révélation cinématique de l'image, puis la page se referme sur la queue de la révélation ; recollé et contrôlé.",
  "expose": {
    "image": { "media": "image", "requis": true, "libelle": "L'image à révéler" },
    "duration_s": { "type": "FLOAT", "defaut": 50, "min": 20, "max": 90, "step": 1, "libelle": "Durée de la révélation", "unite": "s" },
    "conclusion_s": { "type": "FLOAT", "defaut": 11, "min": 4, "max": 20, "step": 1, "libelle": "Durée de la fermeture", "unite": "s" },
    "width": { "type": "INT", "defaut": 704, "libelle": "Largeur", "unite": "px" },
    "height": { "type": "INT", "defaut": 1280, "libelle": "Hauteur", "unite": "px" },
    "fps": { "type": "INT", "defaut": 25, "libelle": "Images par seconde" },
    "seed": { "type": "INT", "defaut": 71, "libelle": "Graine" }
  },
  "etapes": [
    {
      "id": "revelation",
      "rendre": {
        "workflow": "video-reveal-cinematic",
        "media": { "image": "$image" },
        "duration_s": "$duration_s",
        "fps": "$fps",
        "width": "$width",
        "height": "$height",
        "seed": "$seed"
      }
    },
    {
      "id": "queue",
      "extraire_queue": { "video": "$revelation.livrable", "images": 50 }
    },
    {
      "id": "conclusion",
      "rendre": {
        "workflow": "video-reveal-closing",
        "media": { "video": "$queue.depot" },
        "duration_s": "$conclusion_s",
        "fps": "$fps",
        "seed": "$seed"
      }
    },
    {
      "id": "final",
      "recoller": {
        "parts": ["$revelation.livrable", "$conclusion.livrable"],
        "fps": "$fps",
        "largeur": "$width",
        "hauteur": "$height"
      }
    },
    {
      "id": "controle",
      "verifier": [
        { "id": "duree_tenue", "valeur": "$final.mesure.duration_s", "op": "between", "attendu": [40, 120] },
        { "id": "livrable_pese", "valeur": "$final.mesure.bytes", "op": "gte", "attendu": 1000000 }
      ]
    }
  ],
  "livrable": "$final.livrable"
}
