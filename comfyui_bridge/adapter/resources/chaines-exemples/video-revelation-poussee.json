{
  "version": 1,
  "chaine": "video-revelation-poussee",
  "resume": "Une révélation au mode choisi, prolongée par une poussée caméra sur la même image (cadrage identique, donc raccord sans couture), recollée et contrôlée.",
  "expose": {
    "mode": {
      "type": "COMBO",
      "defaut": "video-reveal-cinematic",
      "options_depuis": { "catalogue": { "prefixe": "video-reveal-" } },
      "libelle": "Mode de révélation"
    },
    "image": { "media": "image", "requis": true, "libelle": "L'image à révéler" },
    "duration_s": { "type": "FLOAT", "defaut": 24, "min": 20, "max": 45, "step": 1, "libelle": "Durée de la révélation", "unite": "s" },
    "poussee_s": { "type": "FLOAT", "defaut": 18, "min": 10, "max": 25, "step": 1, "libelle": "Durée de la poussée caméra", "unite": "s" },
    "width": { "type": "INT", "defaut": 704, "libelle": "Largeur", "unite": "px" },
    "height": { "type": "INT", "defaut": 1280, "libelle": "Hauteur", "unite": "px" },
    "fps": { "type": "INT", "defaut": 25, "libelle": "Images par seconde" },
    "seed": { "type": "INT", "defaut": 71, "libelle": "Graine" }
  },
  "etapes": [
    {
      "id": "revelation",
      "rendre": {
        "workflow": "$mode",
        "media": { "image": "$image" },
        "duration_s": "$duration_s",
        "fps": "$fps",
        "width": "$width",
        "height": "$height",
        "seed": "$seed"
      }
    },
    {
      "id": "poussee",
      "rendre": {
        "workflow": "video-still-motion",
        "media": { "image": "$image" },
        "duration_s": "$poussee_s",
        "fps": "$fps",
        "width": "$width",
        "height": "$height"
      }
    },
    {
      "id": "final",
      "recoller": {
        "parts": ["$revelation.livrable", "$poussee.livrable"],
        "fps": "$fps",
        "largeur": "$width",
        "hauteur": "$height"
      }
    },
    {
      "id": "controle",
      "verifier": [
        { "id": "duree_tenue", "valeur": "$final.mesure.duration_s", "op": "between", "attendu": [30, 70] },
        { "id": "les_deux_parts", "valeur": "$final.parts", "op": "eq", "attendu": 2 }
      ]
    }
  ],
  "livrable": "$final.livrable"
}
